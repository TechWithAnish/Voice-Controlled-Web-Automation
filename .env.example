# Copy to .env and edit. Every setting is optional: the defaults below are
# what the assistant uses when the variable is absent.
#
# No API keys are required. Speech recognition uses Google's free endpoint
# through the SpeechRecognition package and weather comes from wttr.in.

# --- browser ---------------------------------------------------------------
# Run Chrome without a visible window.
VA_HEADLESS=false
# Seconds before a page load is abandoned.
VA_PAGE_LOAD_TIMEOUT=30
# Seconds spent looking for an element to click.
VA_ELEMENT_TIMEOUT=8
# Default scroll distance in pixels.
VA_SCROLL_STEP=400
# Only set these if Chrome or chromedriver is not auto-detected.
# VA_CHROME_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe
# VA_CHROMEDRIVER_PATH=
# Required inside containers, never on a workstation: weakens Chrome's sandbox.
VA_DISABLE_SANDBOX=false

# --- speech input ----------------------------------------------------------
VA_SPEECH_LANGUAGE=en-US
VA_LISTEN_TIMEOUT=8
VA_PHRASE_TIME_LIMIT=10
# Seconds of ambient-noise calibration, and how many commands between
# re-calibrations (0 calibrates only once at start-up).
VA_AMBIENT_CALIBRATION=1
VA_RECALIBRATE_EVERY=25
# Leave unset for automatic sensitivity; raise it in a noisy room.
# VA_ENERGY_THRESHOLD=300

# --- speech output ---------------------------------------------------------
VA_TTS_ENABLED=true
VA_TTS_RATE=180
VA_TTS_VOLUME=0.9
# Substring of a voice name, e.g. zira, david, samantha.
# VA_TTS_VOICE=zira

# --- services --------------------------------------------------------------
# google, duckduckgo or bing.
VA_SEARCH_ENGINE=google
VA_WEATHER_TIMEOUT=10
# Used when you say "weather" without naming a city.
# VA_DEFAULT_WEATHER_CITY=Bengaluru

# --- logging ---------------------------------------------------------------
VA_LOG_LEVEL=INFO
# Unset means no log file is written. Logs rotate at VA_LOG_MAX_BYTES.
# VA_LOG_FILE=logs/voice_automation.log
VA_LOG_MAX_BYTES=1048576
VA_LOG_BACKUP_COUNT=3

# --- resilience ------------------------------------------------------------
# Consecutive failures tolerated before the assistant stops.
VA_MAX_CONSECUTIVE_FAILURES=5
